#!/bin/sh

proxy_url=${CLAUDE_DESKTOP_PROXY:-${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}}

if [ -z "${proxy_url}" ]; then
	printf '%s\n' \
		"claude-desktop: no proxy configured; set HTTPS_PROXY or CLAUDE_DESKTOP_PROXY." >&2
	exit 1
fi

export HTTP_PROXY="${proxy_url}"
export HTTPS_PROXY="${proxy_url}"
export ALL_PROXY="${proxy_url}"
export http_proxy="${proxy_url}"
export https_proxy="${proxy_url}"
export all_proxy="${proxy_url}"

exec /opt/claude-desktop/claude-desktop \
	--proxy-server="${proxy_url}" \
	"$@"
